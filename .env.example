DATABASE_URL=postgres://trader:trader@localhost:5432/tradingbot
TRADING_MODE=paper
AUTO_TRADING_ENABLED=false
EMERGENCY_STOP=false
EMERGENCY_CLOSE_POSITIONS=false
TRADINGVIEW_WEBHOOK_SECRET=replace-with-long-random-secret
TRADINGVIEW_HMAC_SECRET=
ADMIN_API_KEY=replace-with-another-long-random-secret
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-long-random-password
# MetaTrader 5 is the only broker. The app has no mock provider;
# the variable is kept so existing .env files stay valid.
BROKER_PROVIDER=mt5
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_ACCOUNT_ID=

# MetaTrader 5. This is the only broker provider: there is no mock fallback.
# An unreachable terminal is reported as disconnected and retried, never faked.
# The terminal itself owns the broker login; the bot only reads the files the
# AurumBridge MQL5 service publishes. Install the service with:
#   packages/broker/scripts/install-mt5-bridge.sh
MT5_BRIDGE_DIR=
MT5_MAGIC=20260101
MT5_PRIMARY_SYMBOL=XAUUSD
# Symbols the service watches and the strategy trades. MT5_PRIMARY_SYMBOL
# is the dashboard focus symbol and is always included in this list.
MT5_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,USDCHF,USDCAD,AUDUSD,NZDUSD,USDCNH,USDSEK
# Only consulted when TRADING_MODE=live: must equal the connected MT5 login, so
# a real-money account can never be traded by changing TRADING_MODE alone.
MT5_LIVE_ACK=
# How often the API re-checks the terminal heartbeat while disconnected.
MT5_RECONNECT_MS=15000
# Host path of the terminal's Common\Files folder, mounted into the API
# container by docker-compose.mt5.yml (see the MT5 overlay).
MT5_HOST_BRIDGE_DIR=

# --- Bot-side strategy runner ---------------------------------------------
# When set, the API evaluates this strategy itself once per closed bar instead
# of waiting for a webhook. The engine still applies every risk rule to whatever
# it emits, so this decides *when* to trade, never *whether* it is safe.
STRATEGY_RUNNER=meanrev-bb-rsi-v1
STRATEGY_TIMEFRAME=M30
STRATEGY_POLL_MS=5000
MAX_LOT_SIZE=0.01
MAX_OPEN_POSITIONS=8
MAX_DAILY_LOSS=100
MAX_DAILY_TRADES=10
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
