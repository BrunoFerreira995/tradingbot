{
  "name": "tradingbot",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/strategy"
  ],
  "scripts": {
    "dev": "bun --filter '@trade/api' dev & bun --filter '@trade/web' dev & wait",
    "typecheck": "bunx tsc --noEmit -p apps/api/tsconfig.json && bunx tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "bunx eslint .",
    "format": "bunx prettier --write .",
    "test": "bun test",
    "research:strategies": "python3 reports/backtest_all_strategies.py",
    "research:plot": "python3 reports/plot_backtests.py",
    "research:meanrev-timeframes": "python3 reports/backtest_meanrev_timeframes.py",
    "research:meanrev-h1": "python3 reports/optimize_meanrev_h1.py",
    "build": "bun --filter '@trade/web' build && bun build apps/api/src/index.ts --target bun --outdir dist/api",
    "db:generate": "bunx drizzle-kit generate --config packages/database/drizzle.config.ts",
    "db:migrate": "bun packages/database/src/migrate.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 delete tradingbot-api tradingbot-web",
    "pm2:logs": "pm2 logs tradingbot-api tradingbot-web",
    "desktop:dev": "cd apps/desktop && bunx tauri dev",
    "desktop:build:mac": "bash apps/desktop/build-macos.sh",
    "mt5:doctor": "bun packages/broker/scripts/doctor-mt5.ts",
    "mt5:build": "./packages/broker/scripts/build-mq5.sh",
    "mt5:install": "./packages/broker/scripts/install-mt5-bridge.sh"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "elysia": "^1.4.0",
    "postgres": "^3.4.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^15.5.27",
    "@tauri-apps/cli": "^2.12.5",
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
