{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TradingBot",
  "version": "0.1.2",
  "identifier": "com.tradingbot.desktop",
  "build": {
    "frontendDist": "../ui",
    "devUrl": "http://localhost:3002"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TradingBot",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../embed/": "embed/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
